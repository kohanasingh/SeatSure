# --- Database ---
DATABASE_URL=postgresql://seatsure:seatsure@localhost:5432/seatsure

# --- Redis (cache, locks, queue, rate limits, idempotency keys) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-only-change-me-in-prod
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
# Sliding-window limit on /auth/* per IP per 15 min (tests raise this)
RATE_LIMIT_AUTH_MAX=10

# --- App ---
WEB_ORIGIN=http://localhost:3000
API_PORT=3001
NODE_ENV=development

# --- Payments (mock provider) ---
SIMULATE_PAYMENT_LATENCY_MS=0

# --- Seed ---
SEED_ADMIN_EMAIL=admin@seatsure.dev
SEED_ADMIN_PASSWORD=admin12345
