# --- Database ---
# connection_limit sized for load (Prisma default pool starves under spikes)
DATABASE_URL=postgresql://seatsure:seatsure@localhost:5432/seatsure?connection_limit=30&pool_timeout=30

# --- Redis (cache, locks, queue, rate limits, idempotency keys) ---
REDIS_URL=redis://localhost:6379
# BullMQ key namespace (tests use their own to avoid racing the dev server)
BULLMQ_PREFIX=bull

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-only-change-me-in-prod
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
# Sliding-window limit on /auth/* per IP per 15 min (tests raise this)
RATE_LIMIT_AUTH_MAX=10
# Booking attempts per user per 15 min (tests and load runs raise this)
RATE_LIMIT_BOOKING_MAX=10

# --- App ---
WEB_ORIGIN=http://localhost:3000
API_PORT=3001
NODE_ENV=development

# --- Payments (mock provider) ---
SIMULATE_PAYMENT_LATENCY_MS=0

# --- Seed ---
SEED_ADMIN_EMAIL=admin@seatsure.dev
SEED_ADMIN_PASSWORD=admin12345
